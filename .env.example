# Condense Industry Demo — environment variables
# Copy this file to .env.local and fill in your Condense ingress URLs.
# Leave a variable empty ("") if that pipeline isn't deployed yet.
# Deployed on Vercel: add these as Environment Variables in the project settings.

# ── Renewable Energy & Utilities ─────────────────────────────────────────────
VITE_ENERGY_API_URL=https://energy-insights.condense.zeliot.in

# ── EV & Connected Mobility ──────────────────────────────────────────────────
VITE_EV_API_URL=https://ev-insights.condense.zeliot.in

# ── Automotive & Telematics ──────────────────────────────────────────────────
VITE_AUTO_API_URL=https://auto-insights.condense.zeliot.in

# ── Airports & Aviation ──────────────────────────────────────────────────────
VITE_AVIATION_API_URL=https://aviation-insights.condense.zeliot.in

# ── Smart Manufacturing / IIoT ───────────────────────────────────────────────
VITE_MFG_API_URL=https://mfg-insights.condense.zeliot.in

# ── Logistics & Supply Chain ─────────────────────────────────────────────────
VITE_LOGISTICS_API_URL=https://logistics-insights.condense.zeliot.in

# ── BFSI / Fintech ───────────────────────────────────────────────────────────
VITE_BFSI_API_URL=https://bfsi-insights.condense.zeliot.in

# ── Retail & E-commerce ──────────────────────────────────────────────────────
VITE_RETAIL_API_URL=https://retail-insights.condense.zeliot.in

# ── Healthcare / Medical IoT ─────────────────────────────────────────────────
VITE_HEALTH_API_URL=https://health-insights.condense.zeliot.in
